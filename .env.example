# =============================================================================
# VIDAL PRO PORTFOLIO — ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env.local and fill in the values
# Never commit .env.local to version control

# =============================================================================
# CORE (Required for production)
# =============================================================================

# SMTP Configuration (Nodemailer)
SMTP_HOST=mail.novatrend.ch
SMTP_PORT=465
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
CONTACT_TO=vidalrenao.lab@outlook.com

# =============================================================================
# LAB ONLY (Optional - used for TempoTutor and CivicFund labs)
# =============================================================================

# Supabase (TempoTutor lab)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Stripe (TempoTutor lab)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# =============================================================================
# DEVELOPMENT (Optional - for local development)
# =============================================================================

# Node Environment
NODE_ENV=development

# Next.js
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# =============================================================================
# PRODUCTION (Optional - for production deployment)
# =============================================================================

# Vercel
VERCEL_URL=vidal-pro-portfolio.vercel.app

# =============================================================================
# SECURITY (Optional - for enhanced security)
# =============================================================================

# Rate Limiting
RATE_LIMIT_WINDOW_MS=3600000
RATE_LIMIT_MAX_REQUESTS=3

# CORS
CORS_ORIGIN=https://vidal-pro-portfolio.vercel.app

# =============================================================================
# MONITORING (Optional - for production monitoring)
# =============================================================================

# Vercel Analytics
VERCEL_ANALYTICS_ID=your_analytics_id

# Speed Insights
VERCEL_SPEED_INSIGHTS_ID=your_speed_insights_id
