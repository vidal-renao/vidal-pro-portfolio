# =============================================================================
# VIDAL PRO PORTFOLIO — ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env.local and fill in the values
# Never commit .env.local to version control

# =============================================================================
# CORE (Required for production)
# =============================================================================

# SMTP Configuration (Nodemailer)
SMTP_HOST=mail.novatrend.ch
SMTP_PORT=465
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
CONTACT_TO=vidalrenao.lab@outlook.com

# =============================================================================
# LEAD NOTIFICATIONS (consultation form -> Supabase + email + WhatsApp)
# =============================================================================

# Supabase (leads storage — service role key, server-only, never expose)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Resend (email notification of new leads)
RESEND_API_KEY=your_resend_api_key
NOTIFICATION_EMAIL=you@example.com

# WhatsApp Cloud API (Meta) — optional lead push notification.
# The sender must be a Cloud API number. Use the Meta test number, NOT a
# personal WhatsApp number (a Cloud API number can't be used in the normal app).
WHATSAPP_TOKEN=your_whatsapp_cloud_api_token
WHATSAPP_PHONE_NUMBER_ID=your_cloud_api_test_number_phone_id
WHATSAPP_WABA_ID=your_whatsapp_business_account_id
WHATSAPP_NOTIFICATION_NUMBER=41779726299
# Approved template (recommended — required to deliver outside the 24h window).
# Template body must map to: {{1}} name · {{2}} sector · {{3}} email · {{4}} needs
WHATSAPP_TEMPLATE_NAME=new_lead
WHATSAPP_TEMPLATE_LANG=es

# =============================================================================
# LAB ONLY (Optional - used for TempoTutor and CivicFund labs)
# =============================================================================

# Supabase (TempoTutor lab)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Stripe (TempoTutor lab)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# =============================================================================
# DEVELOPMENT (Optional - for local development)
# =============================================================================

# Node Environment
NODE_ENV=development

# Next.js
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# =============================================================================
# PRODUCTION (Optional - for production deployment)
# =============================================================================

# Vercel
VERCEL_URL=vidal-pro-portfolio.vercel.app

# =============================================================================
# SECURITY (Optional - for enhanced security)
# =============================================================================

# Rate Limiting
RATE_LIMIT_WINDOW_MS=3600000
RATE_LIMIT_MAX_REQUESTS=3

# CORS
CORS_ORIGIN=https://vidal-pro-portfolio.vercel.app

# =============================================================================
# MONITORING (Optional - for production monitoring)
# =============================================================================

# Vercel Analytics
VERCEL_ANALYTICS_ID=your_analytics_id

# Speed Insights
VERCEL_SPEED_INSIGHTS_ID=your_speed_insights_id
